{
  "name": "nexo-linux",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "NEXO — monitor do sistema e assistente pacman para Arch Linux. Local, sem conta, sem execução de comandos.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:api": "python3 backend/server.py --host 127.0.0.1 --preview",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "python3 nexo start",
    "test": "npm run test:backend && vitest run",
    "test:backend": "python3 -m unittest discover -s tests/backend -p 'test_*.py' -v",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run test && npm run build && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  }
}
