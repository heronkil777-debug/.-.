post_install() {
  update-desktop-database -q 2>/dev/null || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  echo "→ Rode 'stop-jogo' ou procure STOP! no menu de aplicativos."
  echo "→ Para encerrar o servidor local: stop-jogo --parar"
}

post_upgrade() { post_install; }

pre_remove() {
  rm -f /tmp/stop-jogo-*.pid 2>/dev/null || true
}
